# Monitor Server 镜像（多阶段构建，静态单二进制）
# 构建：docker build -f deploy/docker/Dockerfile.server -t monitor-server:latest .
# 运行：docker run -d --name monitor-server -p 8080:8080 \
#        -v $(pwd)/server.yaml:/etc/monitor-server/server.yaml:ro \
#        -v monitor-data:/var/lib/monitor-server \
#        monitor-server:latest
FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git bash
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -H -s /sbin/nologin monitor
COPY --from=build /out/server /usr/local/bin/monitor-server
USER monitor
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/monitor-server"]
CMD ["-config", "/etc/monitor-server/server.yaml"]
